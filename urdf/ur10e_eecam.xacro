<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur10e_robot">

  <!-- Args for starting camera position -->
  <xacro:arg name="cam_x_offset"  default="+0.1"/>
  <xacro:arg name="cam_y_offset"  default="+0.1"/>
  <xacro:arg name="cam_z_offset"  default="+0.1"/>
  <xacro:arg name="cam_rx"        default="+0.0"/>
  <xacro:arg name="cam_ry"        default="-1.570796327"/>
  <xacro:arg name="cam_rz"        default="-1.570796327"/>
  <xacro:arg name="cam_parent"    default="tool0"/>

  <!-- Import robot ur10 xacro file -->
  <xacro:include filename="$(find ur_description)/urdf/inc/ur10e_macro.xacro"/>
  <xacro:ur10e_robot prefix="" />

  <!-- Fixed joint camera -->
  <joint name="camera_robot_joint" type="fixed">
    <origin xyz="$(arg cam_x_offset) $(arg cam_y_offset) $(arg cam_z_offset)" 
            rpy="$(arg cam_rx) $(arg cam_ry) $(arg cam_rz)"/>
    <parent link="$(arg cam_parent)"/>
    <child  link="camera_base_link"/>
  </joint>

  <!-- Import d435 xacro file -->
  <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro" />
  <link name="camera_base_link"/>
  <xacro:sensor_d435 parent="camera_base_link" use_nominal_extrinsics="false" add_plug="false" use_mesh="true">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:sensor_d435>
  
</robot>
