<?xml version="1.0" encoding="UTF-8"?>
<robot name="$(arg name)" xmlns:xacro="http://ros.org/wiki/xacro">
    <!-- robot name parameter -->
    <xacro:arg name="name" default="ur"/>
    <!-- parameters -->
    <xacro:arg name="prefix" default="" />

    <xacro:include filename="$(find ur_moveit_config)/srdf/ur_macro.srdf.xacro"/>

    <xacro:ur_srdf name="$(arg name)" prefix="$(arg prefix)"/>

    <!-- Disable collisions for Robotiq 85 gripper -->
    <disable_collisions link1="ee_collision_box" link2="wrist_3_link" reason="Adjacent" />
</robot>