<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
    <!-- Robotiq 85 Gripper URDF file -->
    <xacro:include filename="$(find robotiq_85_description)/urdf/robotiq_85_gripper_macro.urdf.xacro"/>

    <!-- Gripper macro definition -->
    <xacro:macro name="ur_robotiq_85_gripper" params="tf_prefix">

        <!-- Create a link for the 'tool0' as parent for the gripper -->
        <xacro:robotiq_85_gripper
            prefix="${tf_prefix}"
            parent="${tf_prefix}tool0"
        >
            <origin xyz="0 0 0" rpy="0 -1.57 1.57" /> 
        </xacro:robotiq_85_gripper>

        <!-- Create a non visual link to mark the tool center point -->
        <link name="tcp_gripper">
            <origin xyz="0 0 0" rpy="0 0 0" />
        </link>

        <joint name="tool0_to_tcp_joint" type="fixed">
            <origin xyz="0 0 0.165" rpy="0 0 0" />
            <parent link="${tf_prefix}tool0" />
            <child link="tcp_gripper" />
        </joint>
  </xacro:macro>

</robot>