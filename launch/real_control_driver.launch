<launch>

    <arg name="drivers_config_file" 
         default="$(find manipulators)/config/drivers/ur10e.yaml"/>

    <node name="driver_trajectory_converter_node" pkg="manipulators" 
          type="driver_trajectory_converter_node" output="screen">
      <rosparam command="load" file="$(arg drivers_config_file)" />
    </node>

</launch>